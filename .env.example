# Copy to .env (gitignored) and fill in.
# VITE_* values are inlined into the public client bundle, so never give a secret a VITE_ prefix.

# Supabase dashboard > Project Settings > API.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-publishable-key

# Optional; analytics and error reporting are disabled when unset.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
VITE_SENTRY_DSN=

# Server-only secrets below are for local `supabase functions serve`; in production use `supabase secrets set`.
# The Edge runtime injects SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY itself.

# Stripe billing functions and webhook.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...            # the Pro plan price id read by the functions

# Used by ai-proxy and discovery-worker.
GEMINI_API_KEY=

# PDF export worker.
BROWSER_PDF_WS_ENDPOINT=

# Absolute origin for checkout redirects and email links; email falls back to localhost if unset.
APP_URL=https://your-app.example.com

# Resend API key with sending access; when unset, emails render but are not sent.
RESEND_API_KEY=re_...

# Must be on a domain verified in Resend; accepts `Name <address>`.
EMAIL_FROM=Octant <noreply@useoctant.com>

# Optional reply-to address.
EMAIL_REPLY_TO=

# Support address in email footers.
EMAIL_SUPPORT=support@useoctant.com

# Product name in subjects and templates.
EMAIL_APP_NAME=Octant

# Optional BCP 47 locale for billing emails; defaults to en-US.
EMAIL_LOCALE=

# Optional retry tuning; defaults 3 / 300 / 4000.
EMAIL_RETRY_ATTEMPTS=
EMAIL_RETRY_BASE_DELAY_MS=
EMAIL_RETRY_MAX_DELAY_MS=

# Supabase Dashboard > Authentication > Hooks; paste the whole `v1,whsec_...` value.
SEND_EMAIL_HOOK_SECRET=v1,whsec_...

# Resend webhook signing secret, used by resend-webhook.
RESEND_WEBHOOK_SECRET=whsec_...

# Plan label when the Stripe price has no nickname, and the grace period in the payment-failed email.
BILLING_PLAN_NAME=Pro
BILLING_GRACE_PERIOD_DAYS=7
