# Octant — environment variables
#
# Copy to `.env` and fill in. `.env` is gitignored.
#
# ─────────────────────────────────────────────────────────────────────────────
# FRONTEND (VITE_*) — PUBLIC. Anything with a VITE_ prefix is inlined into the
# client bundle and is visible to anyone who loads the site. NEVER put a secret
# (vendor API key, service-role key, Stripe secret) behind a VITE_ prefix.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase project — from Supabase dashboard › Project Settings › API.
# (These were previously misnamed NEXT_PUBLIC_*, which Vite ignores — the app
#  then silently fell back to a local/dummy Supabase and auth failed.)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-publishable-key

# Observability (optional — features no-op if unset).
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
VITE_SENTRY_DSN=

# ─────────────────────────────────────────────────────────────────────────────
# SERVER-ONLY SECRETS — do NOT belong in this frontend .env for production.
# Set them with `supabase secrets set KEY=...` (Edge Functions) and/or the
# Netlify function environment. They are listed here only for local
# `supabase functions serve` and must never gain a VITE_ prefix.
#   - SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are injected
#     automatically by the Edge Function runtime — do not set them as secrets.
# ─────────────────────────────────────────────────────────────────────────────

# Stripe (billing Edge Functions + webhook)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...            # the Pro plan price id read by the functions

# Google Gemini — used by ai-proxy (gemini provider) and the discovery-worker
# (server-side; the key must NOT be exposed to the browser).
GEMINI_API_KEY=

# PDF export worker
BROWSER_PDF_WS_ENDPOINT=

# App origin. Used by the checkout/portal redirects AND by every email link — an email is read outside
# the app, so a relative URL is dead. If this is unset the email layer falls back to localhost and warns.
APP_URL=https://your-app.example.com

# ─────────────────────────────────────────────────────────────────────────────
# EMAIL (Resend) — consumed by the auth-email-hook / send-email / resend-webhook
# / stripe-webhook Edge Functions via `packages/email`.
#
# With RESEND_API_KEY unset the whole email layer degrades to a no-op: templates
# still render (so a broken one fails in dev too) but nothing is sent, and no
# function errors. Same env-gating as VITE_SENTRY_DSN / VITE_POSTHOG_KEY.
#
# NONE of these may ever gain a VITE_ prefix — that would publish your API key
# in the browser bundle.
# ─────────────────────────────────────────────────────────────────────────────

# Resend API key — Resend dashboard › API Keys. Needs "Sending access".
RESEND_API_KEY=re_...

# Default sender. Must be on a domain verified in Resend, or every send is rejected.
# Accepts a bare address or `Name <address>`.
EMAIL_FROM=Octant <noreply@useoctant.com>

# Optional. Where replies go, if not the From address.
EMAIL_REPLY_TO=

# Support address shown in every email footer. Defaults to support@useoctant.com.
EMAIL_SUPPORT=support@useoctant.com

# Product name in subjects and templates. Defaults to "Octant".
EMAIL_APP_NAME=Octant

# Optional. BCP 47 locale for dates and money in billing emails. Defaults to en-US,
# matching the templates' copy. Set to pt-BR for Brazilian formatting.
EMAIL_LOCALE=

# Optional retry tuning, so a Resend incident can be ridden out by changing a
# secret instead of redeploying. Defaults: 3 / 300 / 4000.
EMAIL_RETRY_ATTEMPTS=
EMAIL_RETRY_BASE_DELAY_MS=
EMAIL_RETRY_MAX_DELAY_MS=

# Supabase Auth "Send Email Hook" secret — Dashboard › Authentication › Hooks.
# Supabase issues it as `v1,whsec_...`; paste the whole value.
SEND_EMAIL_HOOK_SECRET=v1,whsec_...

# Resend webhook signing secret — Resend dashboard › Webhooks › (your endpoint).
# Used by resend-webhook to verify delivery/bounce callbacks.
RESEND_WEBHOOK_SECRET=whsec_...

# Optional billing-email copy. Plan label when the Stripe price has no nickname,
# and the grace period quoted in the payment-failed email.
BILLING_PLAN_NAME=Pro
BILLING_GRACE_PERIOD_DAYS=7
